# CRTLPyme - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration - GCP PostgreSQL Instance
# For GCP Cloud SQL, use the external IP address
# Example: postgresql://postgres:YOUR_PASSWORD@YOUR_GCP_IP:5432/crtlpyme-db?schema=public
# Note: Special characters in password should be URL-encoded
DATABASE_URL="postgresql://postgres:your_password@your_gcp_ip_address:5432/crtlpyme-db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-here-change-in-production"

# Transbank Configuration (Sandbox)
TRANSBANK_API_KEY="your-transbank-sandbox-api-key"
TRANSBANK_ENVIRONMENT="integration"

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"

# Application Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="CRTLPyme"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_CONTACT_EMAIL="support@crtlpyme.cl"

# Debug and Logging
DEBUG="false"
LOG_LEVEL="info"
