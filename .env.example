# CRTLPyme - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# GCP Cloud SQL PostgreSQL Instance
# For GCP Cloud SQL, use the external IP address or Cloud SQL Proxy
# Example: postgresql://postgres:YOUR_PASSWORD@YOUR_GCP_IP:5432/crtlpyme-db?schema=public
# Note: Special characters in password should be URL-encoded
DATABASE_URL="postgresql://postgres:your_password@136.116.45.158:5432/crtlpyme-db?schema=public"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-here-change-in-production"

# ============================================
# SENDGRID CONFIGURATION
# ============================================
# SendGrid API Key for email notifications
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="SG.your-sendgrid-api-key-here"
SENDGRID_FROM_EMAIL="noreply@crtlpyme.cl"
SENDGRID_FROM_NAME="CRTLPyme"

# ============================================
# TRANSBANK CONFIGURATION
# ============================================
# Transbank Webpay Plus Configuration
# For sandbox/integration environment, use the default integration credentials
# For production, replace with your production credentials

# Environment: "integration" or "production"
TRANSBANK_ENVIRONMENT="integration"

# Commerce Code (use IntegrationCommerceCodes for sandbox)
# Integration: 597055555532
# Production: Your assigned commerce code
TRANSBANK_COMMERCE_CODE="597055555532"

# API Key (use IntegrationApiKeys for sandbox)
# Integration: 579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Production: Your assigned API key
TRANSBANK_API_KEY="579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C"

# ============================================
# GOOGLE CLOUD CONFIGURATION
# ============================================
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="CRTLPyme"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_CONTACT_EMAIL="support@crtlpyme.cl"

# ============================================
# DEBUG AND LOGGING
# ============================================
DEBUG="false"
LOG_LEVEL="info"

# ============================================
# SUBSCRIPTION SETTINGS
# ============================================
# Default trial period in days
DEFAULT_TRIAL_DAYS="14"

# Enable/disable automatic subscription renewal
AUTO_RENEW_SUBSCRIPTIONS="true"

# Days before subscription expiry to send reminder email
RENEWAL_REMINDER_DAYS="7"
