generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MULTI-TENANT CORE ============

model Tenant {
  id            String   @id @default(cuid())
  businessName  String
  rut           String   @unique // RUT chileno
  email         String   @unique
  phone         String?
  address       String?
  isActive      Boolean  @default(true)
  planType      PlanType @default(BASIC)
  maxCashiers   Int      @default(2)
  extraCashiers Int      @default(0)

  // SaaS Admin Fields
  accountStatus       AccountStatus @default(ACTIVE)
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  onboardingCompleted Boolean       @default(false)
  lastActivityAt      DateTime?
  totalRevenue        Decimal?      @db.Decimal(12, 2)
  lifetimeMonths      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                   User[]
  products                Product[]
  tenantInventories       TenantInventory[]
  sales                   Sale[]
  cashSessions            CashSession[]
  fixedExpenses           FixedExpense[]
  stockAdjustments        StockAdjustment[]
  inventoryMovements      InventoryMovement[]
  auditLogs               AuditLog[]
  subscriptions           Subscription[]
  tenantManagement        TenantManagement?
  tenantActionLogs        TenantActionLog[]
  subscriptionPayments    SubscriptionPayment[]
  refunds                 Refund[]
  notificationPreferences NotificationPreference[]
  notificationHistory     NotificationHistory[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales              Sale[]
  cashSessions       CashSession[]
  stockAdjustments   StockAdjustment[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]

  @@index([tenantId])
  @@map("users")
}

// ============ PRODUCTS & INVENTORY ============

// Catálogo maestro compartido de productos
model MasterProduct {
  id             String   @id @default(cuid())
  sku            String   @unique // código único global
  barcode        String?  @unique // EAN-13
  name           String
  description    String?
  category       String
  brand          String?
  suggestedPrice Decimal  @db.Decimal(10, 2) // precio sugerido
  unit           String   @default("unidad") // unidad de medida
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenantInventories TenantInventory[]

  @@index([category])
  @@index([barcode])
  @@map("master_products")
}

// Inventario específico de cada tenant (reemplaza Product)
model TenantInventory {
  id              String @id @default(cuid())
  tenantId        String
  masterProductId String

  // Información específica del tenant
  customSku   String? // código interno del tenant (opcional)
  costPrice   Decimal  @db.Decimal(10, 2) // costo de compra del tenant
  salePrice   Decimal  @db.Decimal(10, 2) // precio de venta del tenant
  stock       Int      @default(0)
  minStock    Int      @default(5) // umbral de reposición
  location    String? // ubicación en el almacén
  customNotes String? // notas personalizadas
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterProduct      MasterProduct       @relation(fields: [masterProductId], references: [id])
  saleItems          SaleItem[]
  stockAdjustments   StockAdjustment[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, masterProductId])
  @@index([tenantId])
  @@index([tenantId, customSku])
  @@map("tenant_inventory")
}

// Tabla legacy para mantener compatibilidad (DEPRECATED)
model Product {
  id          String   @id @default(cuid())
  sku         String // código interno
  barcode     String? // EAN-13
  name        String
  description String?
  category    String
  brand       String?
  costPrice   Decimal  @db.Decimal(10, 2) // costo de compra
  salePrice   Decimal  @db.Decimal(10, 2) // precio de venta
  stock       Int      @default(0)
  minStock    Int      @default(5) // umbral de reposición
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, category])
  @@map("products_legacy")
}

model StockAdjustment {
  id                String         @id @default(cuid())
  tenantInventoryId String // referencia al inventario del tenant
  quantity          Int // puede ser negativo para mermas
  type              AdjustmentType
  reason            String?
  userId            String
  tenantId          String
  createdAt         DateTime       @default(now())

  // Relations
  tenantInventory TenantInventory @relation(fields: [tenantInventoryId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tenantInventoryId])
  @@map("stock_adjustments")
}

model InventoryMovement {
  id                String       @id @default(cuid())
  tenantInventoryId String // referencia al inventario del tenant
  type              MovementType // ENTRY, EXIT, ADJUSTMENT
  quantity          Int // cantidad movida (positivo para entradas, negativo para salidas)
  reason            String? // motivo del movimiento
  notes             String? // notas adicionales
  createdBy         String // userId que registró el movimiento
  tenantId          String
  createdAt         DateTime     @default(now())

  // Relations
  tenantInventory TenantInventory @relation(fields: [tenantInventoryId], references: [id])
  user            User            @relation(fields: [createdBy], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tenantInventoryId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("inventory_movements")
}

// ============ SALES & CASH MANAGEMENT ============

model CashSession {
  id             String            @id @default(cuid())
  initialAmount  Decimal           @db.Decimal(10, 2)
  finalAmount    Decimal?          @db.Decimal(10, 2)
  expectedAmount Decimal?          @db.Decimal(10, 2)
  difference     Decimal?          @db.Decimal(10, 2)
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  userId         String
  tenantId       String

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@index([tenantId, userId])
  @@map("cash_sessions")
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    String // número consecutivo por tenant
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  cashReceived  Decimal?      @db.Decimal(10, 2)
  change        Decimal?      @db.Decimal(10, 2)
  status        SaleStatus    @default(COMPLETED)
  userId        String
  tenantId      String
  cashSessionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  items       SaleItem[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id                String  @id @default(cuid())
  quantity          Int
  unitPrice         Decimal @db.Decimal(10, 2)
  unitCost          Decimal @db.Decimal(10, 2) // para calcular margen
  subtotal          Decimal @db.Decimal(10, 2)
  saleId            String
  tenantInventoryId String // referencia al inventario del tenant
  tenantId          String

  // Relations
  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tenantInventory TenantInventory @relation(fields: [tenantInventoryId], references: [id])

  @@index([tenantId, saleId])
  @@map("sale_items")
}

// ============ BUSINESS INTELLIGENCE ============

model FixedExpense {
  id        String           @id @default(cuid())
  name      String // ej: "Arriendo local"
  amount    Decimal          @db.Decimal(10, 2)
  frequency ExpenseFrequency // MONTHLY, DAILY, etc
  isActive  Boolean          @default(true)
  tenantId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("fixed_expenses")
}

// ============ AUDIT & SECURITY ============

model AuditLog {
  id        String   @id @default(cuid())
  action    String // CREATE, UPDATE, DELETE
  entity    String // tabla afectada
  entityId  String // ID del registro
  oldValues Json?
  newValues Json?
  userId    String?
  tenantId  String
  createdAt DateTime @default(now())

  // Relations
  user   User?  @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

// ============ SAAS SUBSCRIPTION MANAGEMENT ============

model SubscriptionPlan {
  id           String       @id @default(cuid())
  name         String
  description  String?
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle @default(MONTHLY)
  trialDays    Int          @default(0)
  isVisible    Boolean      @default(true)
  sortOrder    Int          @default(0)
  features     Json? // JSON array of features
  maxUsers     Int?
  maxProducts  Int?
  maxSales     Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  subscriptions       Subscription[]
  subscriptionMetrics SubscriptionMetrics[]

  @@map("subscription_plans")
}

model Subscription {
  id                  String             @id @default(cuid())
  tenantId            String
  planId              String
  status              SubscriptionStatus @default(ACTIVE)
  startDate           DateTime
  endDate             DateTime?
  billingCycle        BillingCycle       @default(MONTHLY)
  nextBillingDate     DateTime?
  lastBillingDate     DateTime?
  autoRenew           Boolean            @default(true)
  cancelledAt         DateTime?
  cancellationReason  String?
  trialEndsAt         DateTime?
  trialDays           Int                @default(0)
  discountPercent     Decimal?           @db.Decimal(5, 2)
  discountEndsAt      DateTime?
  lifetimeValue       Decimal?           @db.Decimal(12, 2)
  paymentFailureCount Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@index([planId])
  @@map("subscriptions")
}

// ============ SAAS PLATFORM ADMINISTRATION ============

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  sessions         PlatformAdminSession[]
  actionLogs       TenantActionLog[]
  refundsProcessed Refund[]

  @@map("platform_admins")
}

model PlatformAdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_admin_sessions")
}

model TenantManagement {
  id               String        @id @default(cuid())
  tenantId         String        @unique
  accountStatus    AccountStatus @default(ACTIVE)
  suspensionReason String?
  suspendedAt      DateTime?
  suspendedBy      String? // adminId
  blockedReason    String?
  blockedAt        DateTime?
  blockedBy        String? // adminId
  notes            String?
  riskLevel        RiskLevel     @default(LOW)
  lastReviewedAt   DateTime?
  reviewedBy       String? // adminId
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_management")
}

model TenantActionLog {
  id            String       @id @default(cuid())
  tenantId      String
  adminId       String
  action        TenantAction
  previousValue Json?
  newValue      Json?
  reason        String?
  notes         String?
  ipAddress     String?
  createdAt     DateTime     @default(now())

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin  PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([tenantId])
  @@index([adminId])
  @@map("tenant_action_logs")
}

model PlatformMetrics {
  id                      String   @id @default(cuid())
  date                    DateTime @unique
  totalTenants            Int
  activeTenants           Int
  trialTenants            Int
  suspendedTenants        Int
  newTenantsToday         Int
  churnedTenantsToday     Int
  totalRevenue            Decimal  @db.Decimal(12, 2)
  monthlyRecurringRevenue Decimal  @db.Decimal(12, 2)
  averageRevenuePerUser   Decimal  @db.Decimal(10, 2)
  createdAt               DateTime @default(now())

  @@map("platform_metrics")
}

model RevenueReport {
  id                  String       @id @default(cuid())
  period              ReportPeriod
  startDate           DateTime
  endDate             DateTime
  totalRevenue        Decimal      @db.Decimal(12, 2)
  subscriptionRevenue Decimal      @db.Decimal(12, 2)
  oneTimeRevenue      Decimal      @db.Decimal(12, 2)
  tenantCount         Int
  averageTicket       Decimal      @db.Decimal(10, 2)
  currency            String       @default("CLP")
  generatedAt         DateTime     @default(now())

  @@map("revenue_reports")
}

model SubscriptionMetrics {
  id                   String   @id @default(cuid())
  date                 DateTime
  subscriptionPlanId   String
  activeCount          Int
  newCount             Int
  cancelledCount       Int
  renewedCount         Int
  revenue              Decimal  @db.Decimal(12, 2)
  averageLifetimeValue Decimal  @db.Decimal(12, 2)
  churnRate            Decimal  @db.Decimal(5, 2)
  createdAt            DateTime @default(now())

  // Relations
  plan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@index([subscriptionPlanId])
  @@index([date])
  @@map("subscription_metrics")
}

model DashboardSnapshot {
  id           String   @id @default(cuid())
  snapshotDate DateTime
  kpiData      Json
  chartData    Json
  generatedAt  DateTime @default(now())
  expiresAt    DateTime

  @@index([snapshotDate])
  @@map("dashboard_snapshots")
}

// ============ NOTIFICATIONS & EMAILS ============

model EmailTemplate {
  id        String        @id @default(cuid())
  name      String        @unique
  subject   String
  htmlBody  String
  textBody  String
  variables Json?
  category  EmailCategory
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  emailQueue EmailQueue[]

  @@map("email_templates")
}

model EmailQueue {
  id             String        @id @default(cuid())
  templateId     String
  recipientEmail String
  recipientName  String?
  tenantId       String?
  variables      Json?
  priority       EmailPriority @default(NORMAL)
  status         EmailStatus   @default(PENDING)
  scheduledFor   DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?
  retryCount     Int           @default(0)
  maxRetries     Int           @default(3)
  createdAt      DateTime      @default(now())

  // Relations
  template EmailTemplate @relation(fields: [templateId], references: [id])
  logs     EmailLog[]

  @@index([status])
  @@index([scheduledFor])
  @@map("email_queue")
}

model EmailLog {
  id           String     @id @default(cuid())
  emailQueueId String
  event        EmailEvent
  timestamp    DateTime   @default(now())
  metadata     Json?
  ipAddress    String?

  // Relations
  emailQueue EmailQueue @relation(fields: [emailQueueId], references: [id], onDelete: Cascade)

  @@index([emailQueueId])
  @@map("email_logs")
}

model NotificationPreference {
  id                          String   @id @default(cuid())
  tenantId                    String   @unique
  emailOnPaymentSuccess       Boolean  @default(true)
  emailOnPaymentFailure       Boolean  @default(true)
  emailOnSubscriptionExpiring Boolean  @default(true)
  emailOnSubscriptionRenewed  Boolean  @default(true)
  emailOnLowStock             Boolean  @default(true)
  emailOnNewSale              Boolean  @default(false)
  emailOnAccountSuspended     Boolean  @default(true)
  notificationEmail           String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationHistory {
  id        String              @id @default(cuid())
  tenantId  String
  userId    String?
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus
  title     String
  content   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("notification_history")
}

// ============ TRANSBANK PAYMENT INTEGRATION ============

model SubscriptionPayment {
  id                  String        @id @default(cuid())
  subscriptionId      String
  tenantId            String
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("CLP")
  transbankOrderId    String?
  transbankToken      String?
  transbankBuyOrder   String?
  status              PaymentStatus @default(PENDING)
  paymentMethod       String?
  paymentDate         DateTime?
  transactionResponse Json?
  cardLast4           String?
  cardType            String?
  installments        Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  subscription Subscription     @relation(fields: [subscriptionId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refunds      Refund[]
  webhooks     PaymentWebhook[]

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([status])
  @@map("subscription_payments")
}

model PaymentWebhook {
  id               String    @id @default(cuid())
  provider         String    @default("TRANSBANK")
  webhookData      Json
  processed        Boolean   @default(false)
  processedAt      DateTime?
  processedBy      String?
  relatedPaymentId String?
  signature        String?
  createdAt        DateTime  @default(now())

  // Relations
  payment SubscriptionPayment? @relation(fields: [relatedPaymentId], references: [id])

  @@index([processed])
  @@index([relatedPaymentId])
  @@map("payment_webhooks")
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  tenantId          String
  amount            Decimal      @db.Decimal(10, 2)
  reason            String
  status            RefundStatus @default(PENDING)
  processedBy       String? // adminId
  processedAt       DateTime?
  transbankRefundId String?
  createdAt         DateTime     @default(now())

  // Relations
  payment SubscriptionPayment @relation(fields: [paymentId], references: [id])
  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin   PlatformAdmin?      @relation(fields: [processedBy], references: [id])

  @@index([paymentId])
  @@index([tenantId])
  @@map("refunds")
}

// ============ ENUMS ============

enum UserRole {
  PROVEEDOR // Administrador SaaS
  ADMIN // Administrador Cliente
  CAJA // Operador punto de venta
  INVENTARIO // Encargado de stock  
  SOPORTE // Soporte técnico
}

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

enum PaymentMethod {
  CASH // Efectivo
  DEBIT // Débito
  CREDIT // Crédito
  TRANSFER // Transferencia
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum AdjustmentType {
  PURCHASE // Compra
  LOSS // Merma
  CORRECTION // Corrección de inventario
  RETURN // Devolución
}

enum MovementType {
  ENTRY // Entrada de stock
  EXIT // Salida de stock
  ADJUSTMENT // Ajuste de inventario
}

enum ExpenseFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ============ SAAS ADMIN ENUMS ============

enum AccountStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  BLOCKED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum TenantAction {
  CREATED
  SUSPENDED
  BLOCKED
  UNBLOCKED
  SUBSCRIPTION_CHANGED
  USER_CREATED
  SETTINGS_UPDATED
}

enum ReportPeriod {
  DAILY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  EXPIRED
  SUSPENDED
}

// ============ NOTIFICATION ENUMS ============

enum EmailCategory {
  SUBSCRIPTION
  PAYMENT
  SYSTEM
  MARKETING
}

enum EmailPriority {
  HIGH
  NORMAL
  LOW
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailEvent {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

enum NotificationType {
  PAYMENT
  SUBSCRIPTION
  SYSTEM
  ALERT
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  SENT
  FAILED
  READ
}

// ============ PAYMENT ENUMS ============

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
